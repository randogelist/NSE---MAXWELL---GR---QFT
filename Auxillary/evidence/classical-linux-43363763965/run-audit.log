          (HAdd.hAdd.{0, 0, 0}
            (ite.{1} (Eq.{1} i j) (Neg.neg.{0} (WithLp.ofLp.{0} (NSEMaxwell.Classical.gradient p x) k)) 0)
            (HMul.hMul.{0, 0, 0} ν
              (HAdd.hAdd.{0, 0, 0} (WithLp.ofLp.{0} (NSEMaxwell.CurlCurl.secondCoordinate a k j x) i)
                (WithLp.ofLp.{0} (NSEMaxwell.CurlCurl.secondCoordinate a k i x) j))))
