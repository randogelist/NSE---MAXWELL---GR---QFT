  {p : NSEMaxwell.Classical.ScalarField},
  ContDiff.{0, 0, 0} ℝ (↑Top.top.{0}) a →
    ContDiff.{0, 0, 0} ℝ (↑Top.top.{0}) p →
      ∀ (i j k : Fin 3) (x : NSEMaxwell.Classical.Vec),
        Eq.{1}
          ((fderiv.{0, 0, 0} ℝ (fun y => ClassicalMechanics.newtonianStress ν a p y i j) x)
