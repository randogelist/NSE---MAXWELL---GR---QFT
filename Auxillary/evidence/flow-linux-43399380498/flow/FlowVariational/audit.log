@ClassicalMechanicsAssembly.FLOW_VARIATIONAL_ODE : ∀ {T : ℝ},
  LT.lt.{0} 0 T →
    ∀ {u η : NSEMaxwell.Classical.Velocity},
      ClassicalMechanics.SmoothVelocityOn T u →
        ClassicalMechanics.SmoothVelocityOn T η →
          (∀ (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                ∀ (a : NSEMaxwell.Classical.Vec),
                  Eq.{1} (ClassicalMechanics.finiteTimeDerivative T η t a) (u t (η t a))) →
            ∀ (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                ∀ (a : NSEMaxwell.Classical.Vec),
                  HasDerivWithinAt.{0, 0} (fun s => ClassicalMechanics.deformationGradient η s a)
                    (HMul.hMul.{0, 0, 0} (ClassicalMechanics.materialGradientMatrix (u t) (η t a))
                      (ClassicalMechanics.deformationGradient η t a))
                    (Set.Icc.{0} 0 T) t
