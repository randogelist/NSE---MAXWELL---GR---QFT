@ClassicalMechanicsAssembly.FLOW_JACOBIAN_ONE : ∀ {T : ℝ},
  LT.lt.{0} 0 T →
    ∀ {u η : NSEMaxwell.Classical.Velocity},
      ClassicalMechanics.SmoothVelocityOn T u →
        ClassicalMechanics.SmoothVelocityOn T η →
          (Eq.{1} (η 0) fun a => a) →
            (∀ (t : ℝ),
                Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                  ∀ (a : NSEMaxwell.Classical.Vec),
                    Eq.{1} (ClassicalMechanics.finiteTimeDerivative T η t a) (u t (η t a))) →
              (∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                    ∀ (x : NSEMaxwell.Classical.Vec), Eq.{1} (NSEMaxwell.Classical.divergence (u t) x) 0) →
                ∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                    ∀ (a : NSEMaxwell.Classical.Vec),
                      Eq.{1} (Matrix.det.{0, 0} (ClassicalMechanics.deformationGradient η t a)) 1
