ClassicalMechanicsAssembly.JointFlowRegularity : ℝ → NSEMaxwell.Classical.Velocity → Prop
'ClassicalMechanicsAssembly.JointFlowRegularity' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
@ClassicalMechanicsAssembly.FLOW_REALIZATION_OF_JOINT_REGULARITY : ∀ {T : ℝ},
  LT.lt.{0} 0 T →
    ∀ {u : NSEMaxwell.Classical.Velocity},
      ClassicalMechanics.SmoothVelocityOn T u →
        (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → NSEMaxwell.Classical.SpatialPeriodic.{0} (u t)) →
          (∀ (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                ∀ (x : NSEMaxwell.Classical.Vec), Eq.{1} (NSEMaxwell.Classical.divergence (u t) x) 0) →
            ClassicalMechanicsAssembly.JointFlowRegularity T u →
              ∃ η ρ,
                ClassicalMechanics.MaterialPathOn T η ρ ∧
                  ∀ (t : ℝ),
                    Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                      ∀ (a : NSEMaxwell.Classical.Vec),
                        Eq.{1} (ClassicalMechanics.materialVelocity T η t a) (u t (η t a))
