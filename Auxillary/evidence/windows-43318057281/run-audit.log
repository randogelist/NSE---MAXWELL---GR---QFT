    Eq.{1} (NSEMaxwell.Classical.divergence (NSEMaxwell.Classical.spatialCurl a)) 0
'NSEMaxwell.CurlCurl.divergence_curl' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
NSEMaxwell.CurlCurl.viscosity_identity_of_data : ∀ (ν : ℝ) (a B : NSEMaxwell.Classical.Field),
  NSEMaxwell.Classical.Data a →
    Eq.{1} (NSEMaxwell.Classical.spatialCurl a) B →
      Eq.{1} (HSMul.hSMul.{0, 0, 0} ν (NSEMaxwell.Classical.laplacian a))
        (Neg.neg.{0} (HSMul.hSMul.{0, 0, 0} ν (NSEMaxwell.Classical.spatialCurl B)))
'NSEMaxwell.CurlCurl.viscosity_identity_of_data' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
NSEMaxwell.CurlCurl.reconstructed_viscosity_identity : ∀ (ν : ℝ) (m : NSEMaxwell.Classical.Vec)
  (B : NSEMaxwell.Classical.Field),
  NSEMaxwell.Classical.Data (NSEMaxwell.Classical.U m B) →
    Eq.{1} (NSEMaxwell.Classical.spatialCurl (NSEMaxwell.Classical.U m B)) B →
      Eq.{1} (HSMul.hSMul.{0, 0, 0} ν (NSEMaxwell.Classical.laplacian (NSEMaxwell.Classical.U m B)))
        (Neg.neg.{0} (HSMul.hSMul.{0, 0, 0} ν (NSEMaxwell.Classical.spatialCurl B)))
'NSEMaxwell.CurlCurl.reconstructed_viscosity_identity' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
