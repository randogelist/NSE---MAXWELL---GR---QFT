@ClassicalMechanicsAssembly.Literature.L1 : ∀ {T : ℝ},
  LT.lt.{0} 0 T →
    ∀ {u : NSEMaxwell.Classical.Velocity},
      ClassicalMechanics.SmoothVelocityOn T u →
        (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → NSEMaxwell.Classical.SpatialPeriodic.{0} (u t)) →
          (∀ (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                ∀ (x : NSEMaxwell.Classical.Vec), Eq.{1} (NSEMaxwell.Classical.divergence (u t) x) 0) →
            ∃ η ρ,
              ClassicalMechanics.MaterialPathOn T η ρ ∧
                ∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                    ∀ (a : NSEMaxwell.Classical.Vec), Eq.{1} (ClassicalMechanics.materialVelocity T η t a) (u t (η t a))
'ClassicalMechanicsAssembly.Literature.L1' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u},
 ClassicalMechanicsAssembly.Literature.L1]
@ClassicalMechanicsAssembly.Literature.L2 : ∀ {T : ℝ} {u η ρ : NSEMaxwell.Classical.Velocity},
  ClassicalMechanics.SmoothVelocityOn T u →
    ClassicalMechanics.MaterialPathOn T η ρ →
      (∀ (t : ℝ),
          Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
            ∀ (a : NSEMaxwell.Classical.Vec), Eq.{1} (ClassicalMechanics.materialVelocity T η t a) (u t (η t a))) →
        ∀ (t : ℝ),
          Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
            ∀ (a : NSEMaxwell.Classical.Vec),
              Eq.{1} (ClassicalMechanics.materialDiffusion T η t a) (NSEMaxwell.Classical.laplacian (u t) (η t a))
'ClassicalMechanicsAssembly.Literature.L2' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u},
 ClassicalMechanicsAssembly.Literature.L2]
