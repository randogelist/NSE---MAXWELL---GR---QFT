@ClassicalMechanicsAssembly.Literature.CLASSICAL_MECHANICS_MATERIAL_FROM_L1_L2 : ∀ {ν T : ℝ},
  LT.lt.{0} 0 T →
    ∀ {u : NSEMaxwell.Classical.Velocity} {p : NSEMaxwell.Classical.Pressure},
      ClassicalMechanics.SmoothVelocityOn T u →
        ClassicalMechanics.SmoothPressureOn T p →
          (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → NSEMaxwell.Classical.SpatialPeriodic.{0} (u t)) →
            (∀ (t : ℝ),
                Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                  ∀ (x : NSEMaxwell.Classical.Vec), Eq.{1} (NSEMaxwell.Classical.divergence (u t) x) 0) →
              ∃ η ρ,
                ClassicalMechanics.MaterialPathOn T η ρ ∧
                  (∀ (t : ℝ),
                      Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                        ∀ (a : NSEMaxwell.Classical.Vec),
                          Eq.{1} (ClassicalMechanics.materialVelocity T η t a) (u t (η t a))) ∧
                    ((∀ (t : ℝ),
                        Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                          ∀ (x : NSEMaxwell.Classical.Vec),
                            Eq.{1}
                              (HAdd.hAdd.{0, 0, 0} (ClassicalMechanics.finiteMaterialAcceleration T u t x)
                                (NSEMaxwell.Classical.gradient (p t) x))
                              (HSMul.hSMul.{0, 0, 0} ν (NSEMaxwell.Classical.laplacian (u t) x))) ↔
                      ClassicalMechanics.MaterialEquationOn ν T η fun t a => p t (η t a))
