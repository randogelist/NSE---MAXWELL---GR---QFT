def NSEMaxwell.Classical.FeffermanB : ℝ → Prop :=
fun ν =>
  ∀ (a : NSEMaxwell.Classical.Field), NSEMaxwell.Classical.Data a → ∃ u p, NSEMaxwell.Classical.NSSolution ν a u p
def NSEMaxwell.Classical.MaxwellB : ℝ → ℝ → Prop :=
fun ν c =>
  ∀ (m : NSEMaxwell.Classical.Vec) (B₀ : NSEMaxwell.Classical.Field),
    NSEMaxwell.Classical.MagneticData B₀ → ∃ B E ρ J, NSEMaxwell.Classical.MaxwellSolution ν c m B₀ B E ρ J
def NSEMaxwell.Classical.ExactEquivalence : Prop :=
∀ (ν : ℝ),
  LT.lt.{0} 0 ν → ∀ (c : ℝ), LT.lt.{0} 0 c → (NSEMaxwell.Classical.FeffermanB ν ↔ NSEMaxwell.Classical.MaxwellB ν c)
