                NSEGR.localTimeDerivative (NSEGR.boundaryRawVelocity K) t x =
                    NSEGR.tensorDivergence (NSEGR.boundarySpatialTensor K t) x + NSEGR.gradient (fun y => K t y 0 0) x +
                      NSEGR.gradient (NSEGR.boundaryBeta K t) x →
                  NSEGR.localTimeDerivative (NSEGR.boundaryVelocity K) t x =
                      NSEGR.localTimeDerivative (NSEGR.boundaryRawVelocity K) t x +
