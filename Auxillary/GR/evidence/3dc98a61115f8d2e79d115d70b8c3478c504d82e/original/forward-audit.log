    ρ ≠ 0 →
      NSEGR.ScalarBoundaryCompletionLaws ν ρ t0 →
        NSEGR.AnalyticRadialExtensionLaws ρ t0 →
          ∀ (n : NSEGR.NSERepresentative ν t0),
            ∃ g, ∀ᶠ (t : ℝ) in nhds t0, NSEGR.boundaryVelocity (NSEGR.boundaryK g.metric) t = n.velocity t
