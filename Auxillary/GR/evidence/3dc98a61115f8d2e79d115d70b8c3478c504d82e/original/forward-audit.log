@NSEGR.forward_velocity_recovery : ∀ {ν ρ t0 : ℝ} (c : NSEGR.ScalarBoundaryCompletionLaws ν ρ t0)
  (r : NSEGR.AnalyticRadialExtensionLaws ρ t0) (n : NSEGR.NSERepresentative ν t0),
  ∀ᶠ (t : ℝ) in nhds t0,
    NSEGR.boundaryVelocity (NSEGR.boundaryK (NSEGR.forwardRepresentative c r n).metric) t = n.velocity t
