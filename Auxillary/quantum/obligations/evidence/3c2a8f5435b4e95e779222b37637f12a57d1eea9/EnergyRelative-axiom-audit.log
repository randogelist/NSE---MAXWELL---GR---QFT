      Eq.{1}
        (QuantumAdapter.phaseCoeff (HSub.hSub.{0, 0, 0} (QuantumAdapter.drift ν N q) (QuantumAdapter.drift ν N r)) k i)
        (HSub.hSub.{0, 0, 0}
          (HMul.hMul.{0, 0, 0} (Neg.neg.{0} ↑(HMul.hMul.{0, 0, 0} ν (QuantumAdapter.laplaceSymbol k)))
            (QuantumAdapter.phaseCoeff (HSub.hSub.{0, 0, 0} q r) k i))
          (SingularClosure.coefficientLeray k
            (HSub.hSub.{0, 0, 0} (QuantumAdapter.fullTransport N (QuantumAdapter.phaseCoeff q) k)
              (QuantumAdapter.fullTransport N (QuantumAdapter.phaseCoeff r) k))
            i))
